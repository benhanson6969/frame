# ─────────────────────────────────────────────────────────────
#  FRAME — your private settings (this file is NOT uploaded to GitHub)
#  Put your real values after the "=" sign. No spaces, no quotes.
# ─────────────────────────────────────────────────────────────

# 1) AudD token — needed to recognise songs (Fm button).
#    Get it free at https://dashboard.audd.io  (first 300 requests are free)
AUDD_API_TOKEN=

# 2) Musixmatch key — needed to show lyrics on song pages.
#    Get it free at https://developer.musixmatch.com  (free plan = part of the lyrics)
MUSIXMATCH_API_KEY=

# 3) (Optional) Your public address once the site is online, e.g. https://frame-chat.onrender.com
SITE_URL=

# 4) (Optional) Google Search Console "HTML tag" code (only the content="..." value)
GOOGLE_SITE_VERIFICATION=

# 6) (Only on the OLD site) send everyone to the new address, e.g. https://frame.onrender.com
REDIRECT_TO=

# 5) (Optional) Password to see the visitors list at /api/visitors?key=...
ANALYTICS_KEY=

# Contact email shown on the Terms and Privacy pages (optional)
CONTACT_EMAIL=

# Call alerts (push notifications). Copy the keys Frame prints in the logs on first start.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Seconds a call rings before it counts as missed (default 10)
CALL_RING_SECONDS=10

# Full songs inside Frame (YouTube Data API v3 key from Google Cloud, free)
YOUTUBE_API_KEY=
